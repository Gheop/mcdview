#!/bin/sh
# Pre-commit gate. Fast enough to run every time (a few seconds):
#   1. pinned regression on examples + pgModeler samples
#   2. security: XSS escaping and ReDoS/DoS budget
#   3. MySQL/SQLite dialects through sqlglot
#   4. the whole local .sql corpus, strict (any exception fails the commit)
# The full campaign with .dbm (pgmodeler-cli, minutes) and headless Chrome
# is manual: ./tests/grand_banc.py --dbm --chrome 12
set -e
./tests/tester.py --rapide
./tests/test_securite.py
./tests/test_dialectes.py
./tests/test_invariants.py --strict
./tests/test_modeles.py
./tests/test_diff.py
# bounded sample: the local corpus can be thousands of files; a crash-gate on
# a few hundred is enough here, the full sweep is manual / CI runs examples
./tests/grand_banc.py --strict --limite 80
